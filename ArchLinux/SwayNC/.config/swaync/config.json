{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "ignore-gtk-theme": true,
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "control-center-positionX": "right",
    "control-center-positionY": "center",
    "layer-shell": true,
    "layer-shell-cover-screen": false,
    "cssPriority": "user",
    "control-center-margin-top": 0,
    "control-center-margin-bottom": 0,
    "control-center-margin-right": 0,
    "control-center-margin-left": 0,
    "notification-2fa-action": true,
    "notification-inline-replies": true,
    "notification-body-image-height": 130,
    "notification-body-image-width": 260,
    "timeout": 9,
    "timeout-low": 4,
    "timeout-critical": 0,
    "fit-to-screen": false,
    "relative-timestamps": true,
    "control-center-width": 320,
    "control-center-height": 760,
    "notification-window-width": 350,
    "keyboard-shortcuts": true,
    "notification-grouping": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": false,
    "text-empty": "No Notifications",
    "script-fail-notify": true,
    "notification-visibility": {
        "screenshot-prompts-transient": {
            "state": "transient",
            "app-name": "^Screenshot$",
            "summary": "^Screenshot Captured$"
        }
    },
    "widgets": [
        "title#header",
        "buttons-grid#quick",
        "buttons-grid#power",
        "mpris",
        "volume",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "notifications": {
            "vexpand": true
        },
        "title#header": {
            "text": "  Central Hub",
            "clear-all-button": true,
            "button-text": "󰃢"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "mpris": {
            "autohide": false,
            "show-album-art": "never",
            "loop-carousel": true
        },
        "volume": {
            "device": "default",
            "label": " ",
            "slider": true
        },
        "buttons-grid#quick": {
            "buttons-per-row": 4,
            "actions": [
                {
                    "label": " 󰛳 ",
                    "type": "toggle",
                    "active": true,
                    "command": "/home/Zrabbit/.config/shell/script/Confirm_rofi/internet_switch_rofi",
                    "update-command": "sh -c 'nmcli -g networking general 2>/dev/null | grep -qx enabled && echo true || echo false'"
                },
                {
                    "label": " 󰂯 ",
                    "type": "toggle",
                    "command": "if [ \"$SWAYNC_TOGGLE_STATE\" = \"true\" ]; then bluetoothctl power on; else bluetoothctl power off; fi",
                    "update-command": "bluetoothctl show | grep -q 'Powered: yes' && printf true || printf false"
                },
                {
                    "label": "  ",
                    "type": "toggle",
                    "command": "if [ \"$SWAYNC_TOGGLE_STATE\" = \"true\" ]; then rfkill block all; else rfkill unblock all; fi",
                    "update-command": "rfkill --noheadings --output SOFT | grep -q unblocked && printf false || printf true"
                },
                {
                    "label": "  ",
                    "type": "toggle",
                    "command": "if [ \"$SWAYNC_TOGGLE_STATE\" = \"true\" ]; then systemctl --user start idle-inhibit.service; else systemctl --user stop idle-inhibit.service; fi",
                    "update-command": "systemctl --user is-active --quiet idle-inhibit.service && printf true || printf false"
                }
            ]
        },
        "buttons-grid#power": {
            "buttons-per-row": 3,
            "actions": [
                {
                    "label": "  ",
                    "type": "normal",
                    "active": true,
                    "command": "/home/Zrabbit/.config/shell/script/Confirm_rofi/poweroff_confirmation_rofi"
                },
                {
                    "label": "  ",
                    "type": "normal",
                    "active": true,
                    "command": "/home/Zrabbit/.config/shell/script/Confirm_rofi/reboot_confirmation_rofi"
                },
                {
                    "label": " 󰷛 ",
                    "type": "normal",
                    "active": true,
                    "command": "/usr/bin/loginctl lock-session"
                },
                {
                    "label": " 󰗽 ",
                    "type": "normal",
                    "active": true,
                    "command": "/home/Zrabbit/.config/shell/script/Confirm_rofi/logout_confirmation_rofi"
                },
                {
                    "label": " 󰏥 ",
                    "type": "normal",
                    "active": true,
                    "command": "/home/Zrabbit/.config/shell/script/Confirm_rofi/suspend_confirmation_rofi"
                },
                {
                    "label": " 󰒲 ",
                    "type": "normal",
                    "active": true,
                    "command": "/home/Zrabbit/.config/shell/script/Confirm_rofi/hibernate_confirmation_rofi"
                }
            ]
        }
    }
}
