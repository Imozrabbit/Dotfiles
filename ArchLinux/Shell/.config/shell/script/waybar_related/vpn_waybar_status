#!/usr/bin/env bash

vpn="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | awk -F: '$2=="wireguard"{print $1; exit}')"

dns="AdGuard Home (router)"

if [ -n "$vpn" ]; then
    text="󰦝 "
    tooltip="WireGuard: connected\nProfile: $vpn\nDNS: $dns"
    class="connected"
else
    text=" "
    tooltip="WireGuard: disconnected\nDNS: $dns"
    class="disconnected"
fi

printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' \
    "$text" "$tooltip" "$class"
