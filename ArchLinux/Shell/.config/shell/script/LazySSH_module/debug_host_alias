#!/usr/bin/env bash
set -euo pipefail

ssh_configPath="$HOME/.ssh/config"

# Print out the available host aliases
if [[ -f "$ssh_configPath" ]]; then
    printf "\033[1;32mReading the SSH config file at %s...\nCurrent host aliases :\033[0m\n" "$ssh_configPath"
    if grep -Eq "^[[:space:]]*Host[[:space:]]+" "$ssh_configPath"; then
        awk '
            /^[[:space:]]*Host[[:space:]]+/ {
                print "   " $2
            }
        ' "$ssh_configPath"
    else
        printf "\033[1;31mNo SSH host aliases found\033[0m\n"
    fi
else
    printf "\033[1;31mSSH config file not found: %s\033[0m\n" "$ssh_configPath"
fi

# Debug a specific host alias, and pipe it to less for better readability
printf "\n"
read -r -p "SSH Host alias to debug > " ssh_alias

if [[ -z "$ssh_alias" ]]; then
    printf "\033[1;31m⚠ Alias cannot be empty.\033[0m\n"
    exit 0
fi

if ! resolved_config="$(ssh -G "$ssh_alias" 2>&1)"; then
    printf "\033[1;31m⚠ Failed to resolve SSH alias:\033[0m %s\n" "$ssh_alias"
    printf "%s\n" "$resolved_config"
    exit 0
fi

printf "%s\n" "$resolved_config" | bat --paging=always --style=plain --language=ssh_config
