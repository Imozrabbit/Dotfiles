#!/bin/sh
set -eu # Exit on error (-e) and on undefined variables (-u)

# Make sure it only spawn once
lockdir="${XDG_RUNTIME_DIR:?}/screenshot-locks"
mkdir -p "$lockdir"
lockfile="$lockdir/screenshot_region.lock"
exec 9>"$lockfile"
flock -n 9 || exit 0

# The remaining script
OUTDIR="$HOME/Pictures/Screenshots"
TMPDIR="$XDG_RUNTIME_DIR"
TS="$(date +%Y%m%d_%H%M%S_%3N)"
NAME="${TS}_grim.png"
TMPFILE="$TMPDIR/$NAME"
FINALFILE="$OUTDIR/$NAME"
BODY="$(printf '<img src="file://%s"/>\n%s' "$TMPFILE" "$NAME")"

grim -g "$(slurp -b '#00000080')" "$TMPFILE"
# Expire the action prompt so notify-send returns when its toast times out.
CHOICE="$(
  notify-send \
    -e \
    -a Screenshot \
    -t 10000 \
    -A save=Save \
    -A discard=Discard \
    -A edit=Edit \
    -A copy=Copy \
    -A saveshow='Save & Show' \
    -A savecopy='Save & Copy' \
    "Screenshot Captured" "$BODY"
)"

# Do not let wl-copy, swappy, or feh inherit the screenshot lock
flock -u 9
exec 9>&-

case "${CHOICE:-}" in
  save|"")
    if mv -f "$TMPFILE" "$FINALFILE"; then
      notify-send -a Screenshot -t 3000 "Screenshot saved" \
        "$(printf '<img src="file://%s"/>\n%s' "$FINALFILE" "$NAME")"
    else
      notify-send -a Screenshot -u critical "Screenshot save failed" \
        "Capture kept at $TMPFILE"
      exit 1
    fi
    ;;
  discard)
    rm -f -- "$TMPFILE"
    ;;
  edit)
    mv -f "$TMPFILE" "$FINALFILE"
    swappy -f "$FINALFILE"
    ;;
  copy)
    wl-copy --type image/png < "$TMPFILE"
    rm -f -- "$TMPFILE"
    ;;
  close)
    exit 0
    ;;
  saveshow)
    mv -f "$TMPFILE" "$FINALFILE"
    feh "$FINALFILE"
    ;;
  savecopy)
    mv -f "$TMPFILE" "$FINALFILE"
    wl-copy --type image/png < "$FINALFILE"
    ;;
esac
