{
    "$schema": "https://opencode.ai/config.json",
    "shell": "zsh",
    "default_agent": "plan",
    "share": "disabled",
    "autoshare": false,
    "subagent_depth": 2,
    "agent": {
        "explore": {
            "disable": true
        },
        "build": {
            "model": "openai/gpt-6-sol",
            "variant": "medium",
            "temperature": 0.1,
            "permission": {
                "edit": "ask",
                "task": {
                    "*": "ask",
                    "doc-writer": "allow",
                    "scout": "allow",
                    "cavecrew-reviewer": "allow"
                }
            }
        },
        "plan": {
            "model": "openai/gpt-6-sol",
            "variant": "medium",
            "temperature": 0.1,
            "permission": {
                "edit": "deny",
                "task": {
                    "doc-writer": "ask",
                    "cavecrew-reviewer": "allow"
                }
            }
        },
        "cavecrew-builder": {
            "model": "openai/gpt-6-luna",
            "variant": "high",
            "temperature": 0.1
        },
        "cavecrew-investigator": {
            "model": "openai/gpt-6-luna-fast",
            "variant": "high",
            "temperature": 0.1
        },
        "cavecrew-reviewer": {
            "model": "openai/gpt-6-sol",
            "variant": "medium",
            "temperature": 0.1,
            "permission": {
                "task": {
                    "*": "ask",
                    "security-auditor": "allow"
                }
            }
        },
        "conversation": {
            "model": "openai/gpt-6-luna-fast",
            "variant": "high",
            "temperature": 0.1,
            "permission": {
                "*": "deny"
            }
        },
        "doc-writer": {
            "model": "openai/gpt-6-luna",
            "variant": "high",
            "temperature": 0.1,
            "permission": {
                "*": "deny",
                "read": "allow",
                "list": "allow",
                "glob": "allow",
                "grep": "allow",
                "lsp": "allow",
                "edit": "ask",
                "websearch": "allow",
                "webfetch": "allow",
                "question": "allow",
                "external_directory": "deny"
            }
        },
        "learn": {
            "model": "openai/gpt-6-luna",
            "variant": "high",
            "temperature": 0.1,
            "permission": {
                "*": "deny",
                "read": "allow",
                "list": "allow",
                "glob": "allow",
                "grep": "allow",
                "lsp": "allow",
                "task": "ask",
                "skill": "ask",
                "bash": "ask",
                "websearch": "allow",
                "webfetch": "allow",
                "question": "allow"
            }
        },
        "security-auditor": {
            "model": "openai/gpt-6-astra",
            "variant": "low",
            "temperature": 0.1,
            "permission": {
                "*": "deny",
                "read": "allow",
                "list": "allow",
                "glob": "allow",
                "grep": "allow",
                "lsp": "allow",
                "websearch": "allow",
                "webfetch": "allow"
            }
        }
    },
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git",
        "./plugins/caveman/plugin.js",
        "@dietrichgebert/ponytail",
        "@slkiser/opencode-quota@latest"
    ],
    "permission": {
        "*": "ask",
        "todowrite": "allow",
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow"
        },
        "list": "allow",
        "grep": "allow",
        "glob": "allow",
        "lsp": "allow",
        "bash": {
            "*": "ask",
            "git status": "allow",
            "git status *": "allow",
            "git diff": "allow",
            "git diff *": "allow",
            "git log": "allow",
            "git log *": "allow",
            "git show": "allow",
            "git show *": "allow"
        },
        "task": {
            "*": "ask",
            "doc-writer": "allow",
            "scout": "allow",
            "security-auditor": "deny"
        },
        "skill": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow"
    },
    "watcher": {
        "ignore": [
            "node_modules/**",
            "dist/**",
            ".git/**",
            ".DS_Store"
        ]
    },
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama",
            "options": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "gemma4:12b": {
                    "name": "gemma4 12b"
                }
            }
        }
    },
    "enabled_providers": [
        "openai",
        "ollama"
    ]
}
