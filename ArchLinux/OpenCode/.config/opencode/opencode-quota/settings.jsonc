// The old file was left in place; OpenCode Quota no longer reads it.
// Only the settings you chose there are here; a missing key uses its default.
// Every setting and its default: https://github.com/slkiser/opencode-quota/blob/main/docs/readme/configuration.md
{
  "version": 6,
  "sidebar": {
    "show": true,
    "sessionTokens": true
  },
  "toast": {
    "show": false,
    "sessionTokens": true
  },
  "words": {
    "percent": "left",
    "sessionTokens": "tree"
  },
  "providers": {
    "off": []
  },
  "statusLine": {
    "show": false
  },
  "layout": {
    "bar": "squares",
    "evenUse": false
  }
}
