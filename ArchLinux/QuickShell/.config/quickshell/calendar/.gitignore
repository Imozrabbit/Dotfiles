# Keep this module's policy publishable despite the parent repository's rule.
!/.gitignore

# Generated native helpers and release artifacts never belong in Git.
/parse/calendar-sync-helper
/parse/convert
/parse/output/
/dist/

# Maintained local tests, current release preparation and editor tooling.
/dev/
/parse/test/
/parse/.clangd
AGENTS.md

# Disposable fixtures, archives, logs and caches; do not retain obsolete task history.
/.installer*-test.*/
/.updater-test.*/
/.update-bootstrap-test.*/
*.tar.gz
*.log
*.bak
*.backup*
.cache/
__pycache__/
*.pyc
*.qmlc
*.jsc
