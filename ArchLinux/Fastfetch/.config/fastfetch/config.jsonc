{
    "$schema": "file:///home/Zrabbit/.config/fastfetch/config.jsonc",
    "logo": {
        "type": "kitty-direct",
        "source": "/home/Zrabbit/.config/fastfetch/skull.png",
        "color": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "8": "",
            "9": ""
        },
        "width": 28,
        "height": 16,
        "padding": {
            "top": 5,
            "left": 3,
            "right": 5
        },
        "printRemaining": true,
        "preserveAspectRatio": false,
        "recache": false,
        "position": "left",
        "chafa": {
            "fgOnly": false,
            "symbols": "block+border+space-wide-inverted"
        }
    },
    "display": {
        "stat": false,
        "pipe": false,
        "showErrors": false,
        "disableLinewrap": false,
        "hideCursor": false,
        "separator": "",
        "color": {
            "keys": "red",
            "title": "underline_",
            "output": "white",
            "separator": "white"
        },
        "brightColor": true,
        "duration": {
            "abbreviation": false,
            "spaceBeforeUnit": "default"
        },
        "size": {
            "maxPrefix": "YB",
            "binaryPrefix": "jedec",
            "ndigits": 2,
            "spaceBeforeUnit": "default"
        },
        "temp": {
            "unit": "D",
            "ndigits": 1,
            "color": {
                "green": "32",
                "yellow": "93",
                "red": "91"
            },
            "spaceBeforeUnit": "default"
        },
        "percent": {
            "type": [
                "num",
                "num-color"
            ],
            "ndigits": 1,
            "color": {
                "green": "32",
                "yellow": "93",
                "red": "91"
            },
            "spaceBeforeUnit": "default",
            "width": 0
        },
        "bar": {
            "char": {
                "elapsed": "■",
                "total": ""
            },
            "border": {
                "left": "",
                "right": "",
                "leftElapsed": "",
                "rightElapsed": ""
            },
            "color": {
                "elapsed": "auto",
                "total": "dim_white",
                "border": "light_white"
            },
            "width": 10
        },
        "fraction": {
            "ndigits": 2
        },
        "noBuffer": false,
        "key": {
            "width": 22,
            "type": "string",
            "paddingLeft": 0
        },
        "freq": {
            "ndigits": 2,
            "spaceBeforeUnit": "default"
        },
        "constants": []
    },
    "general": {
        "thread": true,
        "processingTimeout": 5000,
        "detectVersion": true,
        "playerName": "",
        "dsForceDrm": false
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────\u001b[0m\u001b[1;34m Hardware \u001b[90m──────────────────────╮"
        },
        {
            "type": "host",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;34m Board\u001b[0m",
            "format": "{name}"
        },
        {
            "type": "display",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;34m Display\u001b[0m",
            "format": "{width}*{height} @{refresh-rate}Hz {inch}″"
        },
        {
            "type": "cpu",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;34m󰻠 CPU\u001b[0m",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;34m󰾲 GPU\u001b[0m",
            "format": "{vendor} {name}"
        },
        {
            "type": "disk",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;34m Disk\u001b[0m",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "memory",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;34m󰘚 RAM\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰──────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭──────────────────────\u001b[0m\u001b[1;33m Software \u001b[90m──────────────────────╮"
        },
        {
            "type": "os",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;33m OS\u001b[0m"
        },
        {
            "type": "de",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;33m DE\u001b[0m"
        },
        {
            "type": "wm",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;33m VM\u001b[0m"
        },
        {
            "type": "kernel",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;33m Kernel\u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;33m󰏖 Packages\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;33m Shell\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰──────────────────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m╭────────────────────────\u001b[0m\u001b[1;31m Misc \u001b[90m────────────────────────╮"
        },
        {
            "type": "command",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;31m󱦠 OS Age\u001b[0m",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;31m Uptime\u001b[0m"
        },
        {
            "type": "localip",
            "key": "\u001b[1;90m│\u001b[0m \u001b[1;31m󰩟 Local IP\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰──────────────────────────────────────────────────────╯"
        },
        {
            "type": "colors",
            "paddingLeft": 20,
            "symbol": "circle",
            "block": {
                "width": 20
            }
        }
    ]
}
