	<icon>archive-extract</icon>
	<name>Extract here</name>
	<submenu></submenu>
	<unique-id>1774538221802157-1</unique-id>
	<command>tar -zxf %f -C %d</command>
	<description>For gzip tarballs</description>
	<range>1-1</range>
	<patterns>*.tar.gz;*.tgz</patterns>
	<startup-notify/>
	<other-files/>
</action>
